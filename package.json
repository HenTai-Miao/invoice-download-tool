{
  "name": "invoice-parse-upload-tool",
  "productName": "发票解析上传工具",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "homepage": "https://github.com/your-organization/invoice-download-tool",
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "build:renderer": "vite build",
    "build:electron": "vite build -c vite.electron.config.ts",
    "pack": "electron-builder --dir -c electron-builder.yml",
    "dist": "electron-builder -c electron-builder.yml",
    "dist:win": "electron-builder -c electron-builder.yml --win",
    "dist:linux": "electron-builder -c electron-builder.yml --linux",
    "dist:linux:deb": "electron-builder -c electron-builder.yml --linux deb",
    "electron:dev": "vite -c vite.electron.config.ts",
    "electron:start": "node scripts/start-electron.js",
    "electron:build": "pnpm run build:renderer && pnpm run build:electron && pnpm run dist",
    "electron:build:linux": "pnpm run build:renderer && pnpm run build:electron && pnpm run dist:linux:deb"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "buffer": "^6.0.3",
    "form-data": "^4.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "electron": "39.0.0",
    "electron-builder": "25.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "~10.5.1",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.5"
  }
}
